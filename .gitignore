src/*.env

# Endpoints de debug/test/dev — nunca al repo
src/debug*
src/dev*
src/test*
src/clean*
src/check*
src/docker*

# Schema (dump completo) fuera del repo. Las migraciones individuales
# en src/migrations/ SI se versionan: son cambios incrementales sin
# datos sensibles, vivibles bajo control de versiones.
src/*.sql

# Helpers / scripts auxiliares
src/helpers/
